<Page x:Class="UpdateHelper.App.Pages.SecurityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:app="clr-namespace:UpdateHelper.App" Title="安全"
      DataContext="{x:Static app:AppHost.Security}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,40,24">
            <TextBlock Text="安全" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />
            <ui:Card>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding StateColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Headline}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Margin="0,8,0,0" Opacity="0.8" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ProviderName}" Margin="0,8,0,0" Opacity="0.7" />
                </StackPanel>
            </ui:Card>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <ui:Button Content="打开 Windows 安全中心" Appearance="Primary" Click="OnOpenSecurityCenter" />
                <ui:Button Content="重新检查" Margin="8,0,0,0" Click="OnRecheck" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
